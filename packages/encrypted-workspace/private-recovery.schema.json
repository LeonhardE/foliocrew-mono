{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.folioview.local/private-recovery-v1",
  "$defs": {
    "PrivateResourceVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "PrivateResourceTime": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PrivateRegistryHead": {
      "type": "object",
      "properties": {
        "registryEpoch": {
          "$ref": "#/$defs/PrivateResourceVersion"
        },
        "registrySequence": {
          "$ref": "#/$defs/PrivateResourceVersion"
        },
        "checkpointDigest": {
          "$ref": "#/$defs/Digest"
        },
        "keyEpoch": {
          "$ref": "#/$defs/PrivateResourceVersion"
        }
      },
      "required": ["registryEpoch", "registrySequence", "checkpointDigest", "keyEpoch"],
      "additionalProperties": false
    },
    "PrivateArchiveBoundary": {
      "type": "object",
      "properties": {
        "state": {
          "enum": ["active", "revoking", "deleted"]
        },
        "version": {
          "$ref": "#/$defs/PrivateResourceVersion"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": ["state", "version", "digest"],
      "additionalProperties": false
    },
    "PrivateRecoveryRequest": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.owner-recovery-evidence.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "nonce": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "deviceId": {
          "$ref": "#/$defs/Identifier"
        },
        "deviceSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "deviceEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "nonce",
        "deviceId",
        "deviceSigningKeyId",
        "deviceEncryptionKeyId"
      ],
      "additionalProperties": false
    },
    "PrivateRecoveryEvidence": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.owner-recovery-evidence.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "requestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "vaultVersion": {
          "$ref": "#/$defs/PrivateResourceVersion"
        },
        "registry": {
          "$ref": "#/$defs/PrivateRegistryHead"
        },
        "archive": {
          "$ref": "#/$defs/PrivateArchiveBoundary"
        },
        "device": {
          "enum": ["active", "inactive"]
        },
        "sourcesDigest": {
          "$ref": "#/$defs/Digest"
        },
        "verifiedAt": {
          "$ref": "#/$defs/PrivateResourceTime"
        },
        "expiresAt": {
          "$ref": "#/$defs/PrivateResourceVersion"
        },
        "registryStart": {
          "oneOf": [
            {
              "$ref": "#/$defs/PrivateRegistryHead"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "rootKeyId",
        "requestDigest",
        "vaultVersion",
        "registry",
        "archive",
        "device",
        "sourcesDigest",
        "verifiedAt",
        "expiresAt",
        "registryStart"
      ],
      "additionalProperties": false
    }
  }
}
